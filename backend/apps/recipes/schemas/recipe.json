{
  "type": "object",
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "ingredients": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "instructions": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "minLength": 1, "maxLength": 2000},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "source_event_sequence": {"type": "integer", "minimum": 1,
            "description": "The task_history event of the research that found this source."}
        },
        "required": ["url", "title"],
        "additionalProperties": false
      }
    },
    "servings": {"type": "string", "maxLength": 200},
    "timing": {"type": "string", "maxLength": 500},
    "uncertainty": {"type": "string", "maxLength": 1000,
      "description": "What the recipe is unsure about, for example an assumed dish or an adaptation."}
  },
  "required": ["title", "ingredients", "instructions", "sources"],
  "additionalProperties": false
}
