# Copy this file to .env and fill in your values
# NEVER commit .env to git

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Auth: leave blank for local development (any password is accepted).
# Before exposing the app to another device, generate a bcrypt hash as described in README.md.
AUTH_PASSWORD_HASH=

# Session signing secret. This development value is intentionally not secure.
# Generate a unique value before remote or shared use:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-random-secret

# OpenRouter model IDs. These models are paid; replace them with models available to your account if needed.
COUNCIL_MODELS=anthropic/claude-sonnet-4-5,google/gemini-2.5-pro,openai/gpt-4o

# Synthesizer model (picks up council responses and unifies them)
SYNTHESIZER_MODEL=anthropic/claude-sonnet-4-5

# Default model for multi-step Agent conversations (must support native tool calls)
TASK_AGENT_MODEL=anthropic/claude-haiku-4.5

# Allowed project directories for file browser (comma-separated absolute paths)
ALLOWED_DIRS=

# ntfy.sh topic for push notifications (optional)
NTFY_TOPIC=

# Tailscale hostname or IP (optional, used for remote dev-host allowance and CORS)
TAILSCALE_HOST=
