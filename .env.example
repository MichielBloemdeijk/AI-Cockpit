# Copy this file to .env and fill in your values
# NEVER commit .env to git

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI API key
OPENAI_API_KEY=sk-proj-your-key-here

# GPT-Live voice provider (backend-only key).
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
OPENAI_LIVE_RESPONSES_MODEL=gpt-5.6-luna
OPENAI_LIVE_REASONING_EFFORT=low
# Task routing always uses managed Responses delegation.
OPENAI_LIVE_IDLE_TIMEOUT_SECONDS=60
OPENAI_LIVE_CONNECT_TIMEOUT_SECONDS=12
# Opt-in local output traces; use a scoped directory inside this repository's data/.
# Traces contain spoken text and tool arguments. Disabled during normal operation.
OPENAI_LIVE_DIAGNOSTICS_DIR=
# Requests provider-exposed summaries; changes the request, so use only for diagnostics.
OPENAI_LIVE_REASONING_SUMMARY=false

# Local OpenAI-compatible server (for example llama.cpp). Keep it loopback-only.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_ALIAS=local/gemma-4-12b
LOCAL_LLM_MODEL=google/gemma-4-12B-it-qat-q4_0-gguf:Q4_0
LOCAL_LLM_CONTEXT_SIZE=16384
LOCAL_LLM_MAX_CONCURRENCY=1

# Explicit personal access for the private local/Tailscale setup.
# Optional AUTH_PASSWORD is plaintext in this ignored private configuration; no hash generation.
JARVIS_ACCESS_MODE=personal
# Optional private password. Never commit your real password.
AUTH_PASSWORD=
JARVIS_PUBLIC_URL=

# Session signing secret. This development value is intentionally not secure.
# Generate a unique value before remote or shared use:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-random-secret
SESSION_COOKIE_SECURE=false

# OpenRouter model IDs shown in the Settings model pickers.
# These models are paid; replace them with models available to your account if needed.
AVAILABLE_MODELS=local/gemma-4-12b,openai/gpt-5.6-luna,openai/gpt-5.6-terra,openai/gpt-5.6-sol,google/gemini-3.5-flash,anthropic/claude-sonnet-5,anthropic/claude-opus-5,x-ai/grok-4.5

# Models queried in Council mode by default
COUNCIL_MODELS=openai/gpt-5.6-terra,google/gemini-3.5-flash,anthropic/claude-sonnet-5

# Synthesizer model (picks up council responses and unifies them)
SYNTHESIZER_MODEL=anthropic/claude-sonnet-5

# Default model for multi-step Agent conversations (must support native tool calls)
TASK_AGENT_MODEL=local/gemma-4-12b

# M1 task pool is verified on the pinned Windows/API route, but remains opt-in.
TASK_POOL_ENABLED=false
TASK_EXECUTOR=legacy
# Empty means only CODEX_TASK_MODEL is selectable; additional models require
# an explicit administrator allowlist. Preferences do not change capabilities.
TASK_EXECUTION_MODEL_ALLOWLIST=
# M3 is additive and disabled until its acceptance/rollout gates pass.
TASK_ORCHESTRATION_ENABLED=false
TASK_ORCHESTRATION_LIVE_ENABLED=false
TASK_ORCHESTRATION_MODEL=gpt-5.6-luna
TASK_ORCHESTRATION_EFFORT=low
# Dedicated API profile; never point this at desktop/subscription credentials.
TASK_ORCHESTRATION_PROFILE=data/codex-orchestration-profile
# Worker tools are configured in Settings and frozen for each execution run.
# Native research replaces the separate discovery model and HTTP fetch pipeline.
# Mutable coding roots must also have a durable task target/attempt lease.
# Comma-separated absolute project directories. An empty list permits private task workspaces only.
TASK_PROJECT_ROOTS=
# Authorize this private Jarvis subscription profile separately; never use the desktop .codex profile.
# Worker and background hosts share one credential owner until exact process exit.
CODEX_SUBSCRIPTION_ENABLED=false
CODEX_SUBSCRIPTION_PROFILE=data/codex-subscription-profile
# Setup chooses one command boundary; rejected native commands never retry in trusted mode.
# trusted inherits the Windows user's access; brokered edits remain path constrained.
TASK_COMMAND_MODE=native
# Elevated Windows sandbox uses scoped native provisioning; no broad retry.
TASK_WINDOWS_SANDBOX=elevated
# Workflows are disabled until an exact id@version:source-digest is allowlisted.
# Find the digest with: cd backend && uv run python -c "from app.services.task_workflows import load_workflow; print(load_workflow('text_report@1').digest)"
TASK_WORKFLOW_ALLOWLIST=
# Enable source-backed reference workflows in an authorized environment.
# Research uses the worker's native hosted web tools, with no separate research model.
TASK_RESEARCH_ENABLED=false

# Allowed project directories for file browser (comma-separated absolute paths)
ALLOWED_DIRS=

# ntfy.sh topic for push notifications (optional)
NTFY_TOPIC=

# Web Push away notifications (generate a VAPID key pair before enabling).
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Optional fixed Tailscale hostname or IP. Normal tailnet access works through
# the frontend's same-origin /api proxy without listing individual devices.
TAILSCALE_HOST=
