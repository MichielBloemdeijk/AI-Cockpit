# Copy this file to .env and fill in your values
# NEVER commit .env to git

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Local OpenAI-compatible server (for example llama.cpp). Keep it loopback-only.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_ALIAS=local/gemma-4-12b
LOCAL_LLM_MODEL=google/gemma-4-12B-it-qat-q4_0-gguf:Q4_0
LOCAL_LLM_CONTEXT_SIZE=16384
LOCAL_LLM_MAX_CONCURRENCY=1

# Local voice pipeline. faster-whisper and kokoro-onnx are loaded only when used.
VOICE_ENABLED=true
VOICE_WAKE_WORD=jarvis
VOICE_STT_MODEL=large-v3-turbo
VOICE_STT_DEVICE=cuda
VOICE_STT_COMPUTE_TYPE=int8_float16
VOICE_STT_LANGUAGE=en
VOICE_STT_BEAM_SIZE=1
VOICE_TTS_ENABLED=true
VOICE_TTS_MODEL_PATH=models/kokoro-v1.0.onnx
VOICE_TTS_VOICES_PATH=models/voices-v1.0.bin
VOICE_TTS_VOICE=af_heart
VOICE_TTS_SPEED=1.05
VOICE_CLOUD_MODEL=openai/gpt-5.6-terra
VOICE_MAX_SEGMENT_SECONDS=30
VOICE_MAX_UPLOAD_BYTES=4000000

# Auth: leave blank for local development (any password is accepted).
# Before exposing the app to another device, generate a bcrypt hash as described in README.md.
AUTH_PASSWORD_HASH=

# Session signing secret. This development value is intentionally not secure.
# Generate a unique value before remote or shared use:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-random-secret
SESSION_COOKIE_SECURE=false

# OpenRouter model IDs shown in the Settings model pickers.
# These models are paid; replace them with models available to your account if needed.
AVAILABLE_MODELS=local/gemma-4-12b,openai/gpt-5.6-luna,openai/gpt-5.6-terra,openai/gpt-5.6-sol,google/gemini-3.5-flash,anthropic/claude-sonnet-5,anthropic/claude-opus-5,x-ai/grok-4.5

# Models queried in Council mode by default
COUNCIL_MODELS=openai/gpt-5.6-terra,google/gemini-3.5-flash,anthropic/claude-sonnet-5

# Synthesizer model (picks up council responses and unifies them)
SYNTHESIZER_MODEL=anthropic/claude-sonnet-5

# Default model for multi-step Agent conversations (must support native tool calls)
TASK_AGENT_MODEL=local/gemma-4-12b

# Allowed project directories for file browser (comma-separated absolute paths)
ALLOWED_DIRS=

# ntfy.sh topic for push notifications (optional)
NTFY_TOPIC=

# Web Push away notifications (generate a VAPID key pair before enabling).
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Optional fixed Tailscale hostname or IP. Normal tailnet access works through
# the frontend's same-origin /api proxy without listing individual devices.
TAILSCALE_HOST=
